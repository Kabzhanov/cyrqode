{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyrqode.dev/schemas/v0.1/profile-product.schema.json",
  "title": "Профиль продукта (SKU)",
  "description": "Сведения, одинаковые для ВСЕХ партий продукта: название, бренд, состав, характеристики, пищевая ценность, производитель. Заносятся один раз. Партия ссылается на продукт, а не повторяет его: состав молока не меняется от партии к партии, а срок годности меняется — поэтому они и живут на разных уровнях.",
  "allOf": [
    {
      "$ref": "https://cyrqode.dev/schemas/v0.1/event.schema.json"
    },
    {
      "type": "object",
      "required": [
        "product"
      ],
      "properties": {
        "product": {
          "type": "object",
          "required": [
            "name",
            "producer_entity_id"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "brand": {
              "type": "string"
            },
            "producer_entity_id": {
              "type": "string",
              "description": "Ссылка на сущность организации-производителя"
            },
            "description": {
              "type": "string"
            },
            "category": {
              "type": "string"
            },
            "gtin": {
              "type": "string",
              "description": "Штрихкод GTIN/EAN, если есть: связывает CYRQODE с существующей товарной номенклатурой"
            },
            "attributes": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "description": "Характеристики: жирность, объём, режим обработки. Свободный набор — у молока, стали и лекарства он разный."
            },
            "composition": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "nutrition": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "number"
                ]
              }
            },
            "storage": {
              "type": "string",
              "description": "Условия хранения: свойство продукта, а не партии"
            },
            "shelf_life": {
              "type": "string",
              "description": "Срок годности как СВОЙСТВО продукта (например «10 суток»). Конкретная дата «годен до» принадлежит партии."
            },
            "certificates": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "number": {
                    "type": "string"
                  },
                  "commitment": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
